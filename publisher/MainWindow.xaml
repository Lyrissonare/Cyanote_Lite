<Window x:Class="CyanotePublisher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cyanote Publisher — Cyanote Lite 文章发布器"
        Width="760" Height="820" MinWidth="680" MinHeight="700"
        WindowStartupLocation="CenterScreen" AllowDrop="True"
        Background="{StaticResource BrushBg}">
  <Grid Margin="20,16,20,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- 标题栏 -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,0,0,14">
      <Border Width="40" Height="40" CornerRadius="10">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF2563EB" Offset="0" />
            <GradientStop Color="#FF60A5FA" Offset="1" />
          </LinearGradientBrush>
        </Border.Background>
        <TextBlock Text="🌊" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
        <TextBlock Text="Cyanote Publisher" FontSize="19" FontWeight="SemiBold" />
        <TextBlock Text="选择 Markdown，一键加入文章列表并推送到 GitHub Pages" FontSize="12"
                   Foreground="{StaticResource BrushText3}" />
      </StackPanel>
    </StackPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>

        <!-- GitHub 端点 -->
        <GroupBox Margin="0,0,0,12">
          <GroupBox.Header>
            <TextBlock Text="GitHub 端点" FontWeight="SemiBold" Foreground="{StaticResource BrushAccent2}" />
          </GroupBox.Header>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="110" />
              <ColumnDefinition Width="120" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="8" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="10" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="8" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBox Grid.Row="0" Grid.Column="0" x:Name="RepoBox" Margin="0,0,8,0"
                     TextChanged="OnFieldChanged" />
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="BranchBox" Margin="0,0,8,0"
                     TextChanged="OnFieldChanged" />
            <TextBox Grid.Row="0" Grid.Column="2" x:Name="BasePathBox" TextChanged="OnFieldChanged"
                     ToolTip="站点文件在仓库中的子目录，留空 = 仓库根目录（例如 docs）" />

            <PasswordBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" x:Name="TokenBox"
                         PasswordChanged="OnFieldChanged"
                         ToolTip="Personal Access Token：classic 需要 repo 权限；fine-grained 需要该仓库 Contents 读写权限。令牌仅保存在本机 %APPDATA%\CyanotePublisher\config.json" />

            <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal">
              <Button x:Name="TestButton" Content="测试连接" Click="OnTestConnection" />
              <TextBlock x:Name="TestStatus" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="12"
                         Foreground="{StaticResource BrushText3}" Text="尚未连接" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal">
              <TextBlock Text="API 地址" Margin="0,0,10,0" VerticalAlignment="Center" FontSize="12"
                         Foreground="{StaticResource BrushText3}"
                         ToolTip="默认 GitHub；GitHub Enterprise 填 https://主机/api/v3" />
              <TextBox x:Name="ApiBaseBox" Width="300" FontSize="12"
                       ToolTip="默认 https://api.github.com，一般无需修改" />
            </StackPanel>
          </Grid>
        </GroupBox>

        <!-- 文章 -->
        <GroupBox>
          <GroupBox.Header>
            <TextBlock Text="文章" FontWeight="SemiBold" Foreground="{StaticResource BrushAccent2}" />
          </GroupBox.Header>
          <StackPanel>

            <StackPanel Orientation="Horizontal">
              <Button x:Name="PickButton" Content="📄 选择 Markdown 文件…" Click="OnPickFile" />
              <CheckBox x:Name="PinnedCheck" Content="置顶" Margin="16,0,0,0" VerticalAlignment="Center" />
              <CheckBox x:Name="DraftCheck" Content="📝 存为草稿（不进公开索引）" Margin="12,0,0,0"
                        VerticalAlignment="Center" />
              <TextBlock x:Name="FileLabel" Margin="14,0,0,0" VerticalAlignment="Center" FontSize="12"
                         Foreground="{StaticResource BrushText3}" Text="未选择文件（也可拖拽 .md 到窗口）"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <Grid Margin="0,12,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="150" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <TextBlock Grid.Row="0" Grid.Column="0" Text="标题" Margin="0,0,10,0" VerticalAlignment="Center"
                         Foreground="{StaticResource BrushText3}" />
              <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" x:Name="TitleBox" />

              <TextBlock Grid.Row="2" Grid.Column="0" Text="slug" Margin="0,0,10,0" VerticalAlignment="Center"
                         Foreground="{StaticResource BrushText3}" />
              <TextBox Grid.Row="2" Grid.Column="1" x:Name="SlugBox" />
              <TextBlock Grid.Row="2" Grid.Column="2" Text="日期 (UTC)" Margin="14,0,10,0"
                         VerticalAlignment="Center" Foreground="{StaticResource BrushText3}" />
              <TextBox Grid.Row="2" Grid.Column="3" x:Name="DateBox" />

              <TextBlock Grid.Row="4" Grid.Column="0" Text="分类" Margin="0,0,10,0" VerticalAlignment="Center"
                         Foreground="{StaticResource BrushText3}" />
              <TextBox Grid.Row="4" Grid.Column="1" x:Name="CategoriesBox" ToolTip="逗号分隔" />
              <TextBlock Grid.Row="4" Grid.Column="2" Text="标签" Margin="14,0,10,0" VerticalAlignment="Center"
                         Foreground="{StaticResource BrushText3}" />
              <TextBox Grid.Row="4" Grid.Column="3" x:Name="TagsBox" ToolTip="逗号分隔" />

              <TextBlock Grid.Row="6" Grid.Column="0" Text="摘要" Margin="0,0,10,0" VerticalAlignment="Top"
                         Foreground="{StaticResource BrushText3}" />
              <TextBox Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="3" x:Name="ExcerptBox" Height="52"
                       TextWrapping="Wrap" VerticalContentAlignment="Top"
                       VerticalScrollBarVisibility="Auto" />
            </Grid>

            <TextBox x:Name="BodyPreview" Margin="0,12,0,0" Height="120" IsReadOnly="True"
                     TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                     FontFamily="Cascadia Code, Consolas" FontSize="12"
                     Foreground="{StaticResource BrushText2}" Text="" />

            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
              <Button x:Name="PublishButton" Style="{StaticResource BtnPrimary}" Content="🚀 推送到 GitHub"
                      Click="OnPublish" MinWidth="160" />
              <TextBlock x:Name="PublishStatus" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="12"
                         Foreground="{StaticResource BrushText3}" Text="" TextTrimming="CharacterEllipsis" />
            </StackPanel>

          </StackPanel>
        </GroupBox>

      </StackPanel>
    </ScrollViewer>

    <!-- 日志 -->
    <GroupBox Grid.Row="3" Margin="0,12,0,0" VerticalAlignment="Stretch">
      <GroupBox.Header>
        <TextBlock Text="日志" FontWeight="SemiBold" Foreground="{StaticResource BrushAccent2}" />
      </GroupBox.Header>
      <TextBox x:Name="LogBox" Height="120" IsReadOnly="True" TextWrapping="NoWrap" AcceptsReturn="True"
               HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
               FontFamily="Cascadia Code, Consolas" FontSize="12" Background="#FF0E1830"
               Foreground="{StaticResource BrushText2}" />
    </GroupBox>

  </Grid>
</Window>
